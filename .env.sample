SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Required. Comma separated bot IDs of Reacji Channeler (e.g. B0123456789).
REACJI_BOT_IDS=
# Optional. Comma separated channel IDs to react in. Empty means all channels.
REACJI_CHANNEL_IDS=
# Optional. Your app ID (A...). When set, events for other apps are ignored.
SLACK_APP_ID=
